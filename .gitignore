# Live rodeo data -- this is the whole point of NOT committing it. Every
# install generates its own on first run (see database.init_db()).
rodeo_data.db
rodeo_data.db-journal

# Generated on every scoring action -- see xml_export.py. Shipping stale
# example data in the repo would be actively misleading to clone into a
# fresh install.
exports/*.xml

# Cached parsed draw-sheet uploads (see importer.py) -- transient, tied
# to one machine's in-progress import, not something to version.
import_cache/*

# Auto-generated safety copies made right before a "Restore from file"
# (see backup_import in app.py) -- local safety net, not something to
# version or ship.
backups/

# Saved rodeo databases (see app.py's /start routes) -- these are the
# user's actual event data, auto-archived whenever a new rodeo starts
# or a different saved one is loaded. Same reasoning as rodeo_data.db
# itself: real data, not something to version.
saved_rodeos/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Editor / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
